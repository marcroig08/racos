# Solo chat.php es accesible desde fuera. La clave (_config.php), la ficha
# (conocimiento.md) y los contadores (_data/) no se pueden descargar.
Options -Indexes

<IfModule mod_authz_core.c>
  Require all denied
  <Files "chat.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "chat.php">
    Allow from all
  </Files>
</IfModule>

<IfModule mod_headers.c>
  <Files "chat.php">
    Header set Cache-Control "no-store"
  </Files>
</IfModule>
